{
  "name": "prompt-library-experiment-hub",
  "version": "1.0.0",
  "description": "Manage prompts, versions, and experiments across many projects",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev:worker --workspace=backend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": ["prompt-engineering", "llm", "experiments", "evaluation"],
  "author": "",
  "license": "MIT"
}
